.start-rhai
    fn validate_order_boolean(r1) {
        if r1.order != 2 {
            throw "The register must be a boolean register to use this macro (it must have exactly two states).";
        }
        
        return ();
    }
    fn validate_order_r3_ge_r2_or_r3_ge_r1(r1, r2, r3) {
        let o1 = r1.order;
        let o2 = r2.order;
        let o3 = r3.order;
        if o3 < o2 && o3 < o1 {
            throw `Expected the violated constraint: ${r3} (order ${o3}) >= ${r2} (${o2}) or ${r3} (${o3}) >= ${r1} (${o1}).`;
        }

        return ();
    }
.end-rhai

.macro sub {
    ($R:reg $N:int) => add -$R $N
}

.macro inc {
    ($R:reg) => add $R 1
}

.macro dec {
    ($R:reg) => sub $R 1
}

.macro move {
    ($R1:reg to $R2:reg) => {
        zero_loop:
            solved-goto $R1 move_done
            dec $R1
            inc $R2
            goto zero_loop
        move_done:
    }
}

.macro set {
    ($R1:reg to $R2:reg) => {
        set $R1 to 0
        move $R2 to $R1
    }

    ($R:reg to $N:int) => {
        zero_loop:
            solved-goto $R move_done
            dec $R
            goto zero_loop
        move_done:
            add $R $N
    }
}

.macro if {
    ($R:reg $code:block) => {
        rhai validate_order_boolean($R)
        if not-solved $R {
            $code
        }
    }
    (not $R:reg $code:block) => {
        rhai validate_order_boolean($R)
        if solved $R {
            $code
        }
    }
    (solved $R:reg $code:block) => {
            solved-goto $R do_if
            goto after_if
        do_if:
            $code
        after_if:
    }
    (not-solved $R:reg $code:block) => {
            solved-goto $R after_if
            $code
        after_if:
    }
    (solved $R:reg $code1:block else $code2:block) => {
        if not-solved $R $code2 else $code1
    }
    (not-solved $R:reg $code1:block else $code2:block) => {
            if not-solved $R {
                $code1
                goto over_else
            }
            $code2
        over_else:
    }
    ($R:reg equals $N:int $code:block) => {
        if $R equals $N $code else {}
    }
    ($R:reg not-equals $N:int $code:block) => {
        if $R not-equals $N $code else {}
    }
    ($R:reg equals $N:int $code1:block else $code2:block) => {
        if $R not-equals $N $code2 else $code1
    }
    ($R:reg not-equals $N:int $code1:block else $code2:block) => {
        sub $R $N
        if not-solved $R {
            add $R $N
            $code1
        } else {
            add $R $N
            $code2
        }
    }
    ($R1:reg equals $R2:reg using $R3:reg $code:block) => {
            rhai validate_order_r3_ge_r2_or_r3_ge_r1($R1, $R2, $R3)
            set $R3 to 0
        equals_loop:
            solved-goto $R1 first_zero
            solved-goto $R2 fail_loop
            dec $R1
            dec $R2
            inc $R3
            goto equals_loop
        first_zero:
            solved-goto $R2 success_loop
        fail_loop:
            solved-goto $R3 fail
            inc $R1
            inc $R2
            dec $R3
            goto fail_loop
        success_loop:
            solved-goto $R3 success
            inc $R1
            inc $R2
            dec $R3
            goto success_loop
        success:
            $code
        fail:
    }
    ($R1:reg not-equals $R2:reg using $R3:reg $code:block) => {
            rhai validate_order_r3_ge_r2_or_r3_ge_r1($R1, $R2, $R3)
            set $R3 to 0
        equals_loop:
            solved-goto $R1 first_zero
            solved-goto $R2 fail_loop
            dec $R1
            dec $R2
            inc $R3
            goto equals_loop
        first_zero:
            solved-goto $R2 success_loop
        fail_loop:
            solved-goto $R3 fail
            inc $R1
            inc $R2
            dec $R3
            goto fail_loop
        success_loop:
            solved-goto $R3 success
            inc $R1
            inc $R2
            dec $R3
            goto success_loop
        // Only change is to swap these two labels
        fail:
            $code
        success:
    }
    ($R1:reg equals $R2:reg using $R3:reg $code1:block else $code2:block) => {
            if $R1 equals $R2 using $R3 {
                $code1
                goto over_else
            }
            $code2
        over_else:
    }
    ($R1:reg not-equals $R2:reg using $R3:reg $code1:block else $code2:block) => {
        if $R1 equals $R2 using $R3 $code2 else $code1
    }
}

.macro loop {
    ($code:block) => {
        !continue:
            $code
            goto continue
        !break:
    }
}

.macro while {
    (solved $R:reg $code:block) => {
            goto continue
        do_iteration:
            $code
        !continue:
            solved-goto $R do_iteration
        !break:
    }
    (not-solved $R:reg $code:block) => {
        !continue:
            solved-goto $R break
            $code
            goto continue
        !break:
    }
    ($R:reg equals $N:int $code:block) => {
        loop {
            if $R not-equals $N {
                goto break
            }
            $code
        }
    }
    ($R:reg not-equals $N:int $code:block) => {
        loop {
            if $R equals $N {
                goto break
            }
            $code
        }
    }
    ($R1:reg equals $R2:reg using $R3:reg $code:block) => {
        loop {
            if $R1 not-equals $R2 using $R3 {
                goto break
            }
            $code
        }
    }
    ($R1:reg not-equals $R2:reg using $R3:reg $code:block) => {
        loop {
            if $R1 equals $R2 using $R3 {
                goto break
            }
            $code
        }
    }
}

.start-rhai
    fn repeat(code, start, end) {
        repeat(code, start, end, ())
    }

    fn repeat(code, start, end, name) {
        let output = [];

        for i in range(start, end) {
            if name != () {
                output.push([ ".define", `\$${name}`, i ]);
            }
            output.extend(code);
        }

        return output;
    }
.end-rhai

.macro repeat {
    ($times:int $code:block) => rhai repeat($code, 1, $times)

    ($times:int $var:ident $code:block) => rhai repeat($code, 1, $times, $var)

    // should parse nested for loops such as `repeat j from $i to 10 { ... }`
    // because the outer $i should be evaluated first
    ($var:ident from $start:int to $end:int $code:block) => {
        rhai repeat($code, $start, $end, $var)
    }
}

.start-rhai
    fn multiply(r1, r2, r3) {
        validate_same_orders(r1, r2, r3);
        // TODO: Implement multiplication. Result in register r1, nullify r2/r3

        throw "Three register multiplication is unimplemented";
    }
.end-rhai

.macro multiply {
    ($R1:reg $R2:reg using $R3:reg) => {
        rhai multiply($R1, $R2, $R3)
    }
    ($R1:reg $N:int at $R2:reg) => {
        multiply_loop:
            solved-goto $R1 multiply_done
            add $R2 $N
            dec $R1
            goto multiply_loop
        multiply_done:
    }
}

