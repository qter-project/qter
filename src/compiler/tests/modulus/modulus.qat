.registers {
    B, A ← 3x3 builtin (24, 210)
}

.define $MOD 13

input "Number to modulus:" A

// Calculate `B = (-A) mod 13`
while not-solved A {
    if solved B {
        add B $MOD
    }

    dec A
    dec B
}

// Calculate -(A mod 13)
if not-solved B {
    sub B $MOD
}

halt "The modulus is" -B
